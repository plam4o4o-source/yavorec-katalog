{
  // Проверка на типовете в ИЗГЛЕДИТЕ (src/) — обикновени <script> файлове с общо
  // глобално пространство, в браузърната среда на Electron. Само проверка.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "strict": false,
    // v2.4.72: без шум за този код (измерено) — мъртъв код и функция, която
    // връща стойност само в някои случаи, спират PR-а.
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitThis": true
  },
  "include": ["src/udk.js", "src/views/*.js", "types/renderer-globals.d.ts", "types/api.generated.d.ts", "types/db.generated.d.ts", "types/ipc-contract.d.ts"]
}
