{
  // Проверка на типовете в ГЛАВНИЯ процес (npm run typecheck) — само проверка,
  // нищо не се компилира: програмата си остава на JavaScript. Виж CONTRIBUTING.md.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["es2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false,
    // v2.4.75 (т. 4): null и undefined са отделни типове — виж tsconfig.renderer.json.
    "strictNullChecks": true,
    // v2.4.77 (т. 4): „може да липсва“ (x?: T) и „изрично undefined“ са различни неща.
    "exactOptionalPropertyTypes": true,
    // v2.4.72: без шум за този код (измерено) — мъртъв код и функция, която
    // връща стойност само в някои случаи, спират PR-а.
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitThis": true
  },
  "include": ["*.js", "handlers/*.js", "db/*.js", "scripts/*.js", "types/main-globals.d.ts", "types/db.generated.d.ts", "types/ipc-contract.d.ts"]
}
