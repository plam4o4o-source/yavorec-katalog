{
  // Проверка на типовете в ГЛАВНИЯ процес (npm run typecheck) — само проверка,
  // нищо не се компилира: програмата си остава на JavaScript. Виж CONTRIBUTING.md.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["es2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["*.js", "handlers/*.js", "db/*.js", "scripts/*.js", "types/main-globals.d.ts"]
}
